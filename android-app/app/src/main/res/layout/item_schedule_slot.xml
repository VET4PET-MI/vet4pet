<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <!-- Time label -->
    <TextView
        android:id="@+id/tv_slot_time"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:fontFamily="monospace"
        tools:text="09:00" />

    <!-- ── APPOINTMENT card ──────────────────────────────────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_appt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/slate_200">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Type color bar -->
            <View
                android:id="@+id/view_type_bar"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:minHeight="44dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_appt_pet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Buddy" />

                <TextView
                    android:id="@+id/tv_appt_owner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="David Cohen" />

                <TextView
                    android:id="@+id/tv_appt_type_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:alpha="0.7"
                    tools:text="Checkup · 30 min" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── BLOCK row ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/block_slot_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/block_slot_text"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tv_block_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/block_slot_text"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Staff meeting" />

        <ImageButton
            android:id="@+id/btn_delete_block"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/block_slot_text"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <!-- ── EMPTY slot actions ────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/btn_book_slot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/schedule_book"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary"
            android:paddingVertical="8dp"
            android:paddingStart="4dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_block_slot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/schedule_block"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:alpha="0.6"
            android:paddingVertical="8dp"
            android:paddingEnd="4dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
