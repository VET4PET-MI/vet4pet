<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- ── Pet photo (circular) + camera badge ── -->
        <FrameLayout
            android:id="@+id/frame_pet_photo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_pet_photo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:padding="16dp"
                android:src="@drawable/ic_nav_pets"
                android:backgroundTint="?attr/colorSecondaryContainer"
                app:tint="?attr/colorOnSecondaryContainer"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
                tools:ignore="ContentDescription" />

            <!-- Camera badge (bottom-end) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/badge_camera"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="11dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_edit"
                    app:tint="?attr/colorOnPrimary"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- ── Pet name ── -->
        <TextView
            android:id="@+id/tv_pet_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/img_pet_photo"
            app:layout_constraintEnd_toStartOf="@id/img_chevron"
            app:layout_constraintTop_toTopOf="@id/img_pet_photo"
            tools:text="Buddy" />

        <!-- ── Breed / species ── -->
        <TextView
            android:id="@+id/tv_pet_breed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="@id/tv_pet_name"
            app:layout_constraintEnd_toStartOf="@id/img_chevron"
            app:layout_constraintTop_toBottomOf="@id/tv_pet_name"
            tools:text="Labrador Retriever" />

        <!-- ── Gender + Age meta row ── -->
        <LinearLayout
            android:id="@+id/layout_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toStartOf="@id/tv_pet_name"
            app:layout_constraintEnd_toStartOf="@id/img_chevron"
            app:layout_constraintTop_toBottomOf="@id/tv_pet_breed"
            app:layout_constraintBottom_toBottomOf="@id/img_pet_photo">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_gender"
                app:tint="?attr/colorPrimary"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tv_pet_gender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Female" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_age"
                app:tint="?attr/colorPrimary"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tv_pet_age"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="3 years" />

        </LinearLayout>

        <!-- ── Disclosure chevron ── -->
        <ImageView
            android:id="@+id/img_chevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:ignore="ContentDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
