# Server
PORT=5000

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# JWT signing secret — use a long random string (32+ chars)
JWT_SECRET=replace_with_a_long_random_secret_32_chars_minimum
