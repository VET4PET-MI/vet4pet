# Server
PORT=5000

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# JWT signing secret — use a long random string (32+ chars)
JWT_SECRET=replace_with_a_long_random_secret_32_chars_minimum

# Cloudinary (for medical-record file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Allowed CORS origin in production (the deployed frontend URL).
# Leave blank in dev — the server falls back to permissive CORS.
# Example: CLIENT_ORIGIN=https://vet4pet.vercel.app
CLIENT_ORIGIN=

# 8x8 JaaS (Jitsi as a Service) — token-based video calls.
# Without these the app falls back to meet.jit.si, which requires the moderator to sign in
# with Google and fails inside the Android WebView. Create a free account at jaas.8x8.vc,
# then under "API Keys" generate a key and copy the values below.
# JAAS_APP_ID : the AppID / tenant, looks like "vpaas-magic-cookie-xxxxxxxx"
# JAAS_KID    : the API key id shown next to the key (usually "<AppID>/<suffix>")
# JAAS_PRIVATE_KEY : the downloaded RSA private key (PEM). Paste as a single line with
#                    literal \n between lines, e.g. "-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----"
JAAS_APP_ID=
JAAS_KID=
JAAS_PRIVATE_KEY=
